<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ecommerce.ventasapp" version="0.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <feature name="FirebasexCorePlugin">
        <param name="android-package" value="org.apache.cordova.firebasex.FirebasexCorePlugin" />
        <param name="onload" value="true" />
    </feature>
    <feature name="FirebasexAuthPlugin">
        <param name="android-package" value="org.apache.cordova.firebasex.FirebasexAuthPlugin" />
        <param name="onload" value="true" />
    </feature>
    <feature name="FirebasexFirestorePlugin">
        <param name="android-package" value="org.apache.cordova.firebasex.FirebasexFirestorePlugin" />
        <param name="onload" value="true" />
    </feature>
    <name>Comercio</name>
    <description>Aplicación móvil de comercio electrónico</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <resource-file src="resources/android/google-services.json" target="app/google-services.json" />
    <icon density="ldpi" src="resources/android/icon/drawable-ldpi-icon.png" />
    <icon density="mdpi" src="resources/android/icon/drawable-mdpi-icon.png" />
    <icon density="hdpi" src="resources/android/icon/drawable-hdpi-icon.png" />
    <icon density="xhdpi" src="resources/android/icon/drawable-xhdpi-icon.png" />
    <icon density="xxhdpi" src="resources/android/icon/drawable-xxhdpi-icon.png" />
    <icon density="xxxhdpi" src="resources/android/icon/drawable-xxxhdpi-icon.png" />
    <preference name="loglevel" value="DEBUG" />
    <preference name="GradlePluginGoogleServicesEnabled" value="true" />
    <preference name="ScrollEnabled" value="false" />
    <preference name="BackupWebStorage" value="none" />
</widget>

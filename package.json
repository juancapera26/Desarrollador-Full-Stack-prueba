{
  "name": "prueba-desarrollador-full-stack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "firebase emulators:exec --only firestore --project catalogo-productos-77ab0 \"ng test --watch=false --browsers=ChromeHeadless\"",
    "www:sync": "if exist www rmdir /s /q www && xcopy \"dist\\prueba-desarrollador-full-stack\\browser\" www /E /I /Y",
    "android:build": "npm run build && npm run www:sync && npx cordova build android",
    "android:run": "npm run build && npm run www:sync && npx cordova run android"
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@ionic/angular": "^8.7.3",
    "firebase": "^12.19.0",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "cordova-android": "^15.1.0",
    "firebase-tools": "^15.30.2",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  },

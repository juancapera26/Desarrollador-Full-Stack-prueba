rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas abiertas: esta prueba técnica no usa Firebase Authentication,
    // tiene su propio AuthService. Aceptable solo como mock de prueba,
    // no representa una configuración de producción.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
